# ────────────────────────────────────────────────────────
# COPY THIS TO .env  —  NEVER COMMIT .env TO GIT
# ────────────────────────────────────────────────────────

# PostgreSQL (RDS) connection
# Local dev:  localhost
# On EC2:     use the RDS endpoint from AWS Console
#             e.g. taskvault.abc123xyz.us-east-1.rds.amazonaws.com
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taskvault
DB_USER=postgres
DB_PASSWORD=your_password_here

# Express server
PORT=5000

# React frontend URL (for CORS)
# Local dev:  http://localhost:3000
# Production: https://your-cloudfront-distribution.cloudfront.net
CLIENT_URL=http://localhost:3000
